{
  "seed": 42,
  "num_folds": 5,
  "folds_dir": "folds",
  "output_dir": "outputs",
  "data_root": "data",
  "image_columns": [
    "外观检查_1",
    "外观检查_2",
    "颈围、甲颏距离和胸颏距离_1",
    "颈围、甲颏距离和胸颏距离_2",
    "张口度_1",
    "上唇咬合试验_1",
    "牙齿检查_1",
    "Mallampati分级_1"
  ],
  "video_columns": [
    "前屈和后仰_1",
    "前屈和后仰_2"
  ],
  "require_all_media": true,
  "image_model_name": "dinov2-base",
  "video_model_name": "videomae-base",
  "image_checkpoint_template": "outputs/{image_column}/fold_{fold}/best.pt",
  "video_checkpoint_template": "video_outputs/{video_column}/fold_{fold}/best.pt",
  "image_size": 224,
  "num_frames": 16,
  "num_workers": 4,
  "feature_batch_size": 16,
  "train_batch_size": 64,
  "valid_batch_size": 128,
  "hidden_dim": 256,
  "dropout": 0.2,
  "epochs": 100,
  "lr": 0.001,
  "weight_decay": 0.0001,
  "warmup_ratio": 0.1,
  "use_amp": true,
  "max_grad_norm": 1.0,
  "early_stop_patience": 20,
  "decision_threshold": 0.5
}
